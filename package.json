{
  "name": "@kidlib/web-audio",
  "version": "0.1.6",
  "description": "High-level Web Audio primitives for musical instruments and tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KristinnRoach/web-audio.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./io": {
      "types": "./dist/io.d.ts",
      "import": "./dist/io.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "changeset": "vp exec changeset",
    "bump": "vp exec changeset version",
    "release": "vp check && vp run test:all && npm login && vp exec changeset publish",
    "build:worklets": "node build-processors.js",
    "build": "vp run clean && vp build",
    "prepack": "vp run build",
    "watch:processors": "node watch-processors.js",
    "watch": "concurrently \"vp test watch\" \"vp build --watch\" \"vp run watch:processors\"",
    "clean": "rimraf dist",
    "test": "vp test run",
    "test:browser": "vp test run --config vitest.browser.config.ts",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test",
    "test:all": "vp run test && vp run test:browser",
    "prepare": "vp config"
  },
  "dependencies": {
    "webmidi": "^3.1.16"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/audioworklet": "^0.0.72",
    "@types/node": "^24.13.3",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "playwright": "^1.53.2",
    "rimraf": "^5.0.1",
    "typescript": "5.8.3",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.5.2"
}
